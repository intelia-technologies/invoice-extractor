{
  "$description": "Invoice Extractor design tokens — system \"Calco\" (carbon copy). W3C Design Tokens format. SINGLE SOURCE OF TRUTH: edit this file, then run `node scripts/build-design-tokens.mjs` to regenerate design/tokens.css and site/tokens.css. Naming: primitive.color.<hue>.<step> -> --ie-<hue>-<step>; primitive.<group>.<name> -> --ie-<group>-<name>; semantic.<mode>.<name> -> --ie-<name>.",
  "primitive": {
    "color": {
      "white": { "$type": "color", "$value": "#ffffff" },
      "steel": {
        "50": { "$type": "color", "$value": "#f3f4f1", "$description": "Recycled-paper grey: light page background" },
        "100": { "$type": "color", "$value": "#e9ebe6" },
        "200": { "$type": "color", "$value": "#d5d8d2" },
        "400": { "$type": "color", "$value": "#7d828c" },
        "500": { "$type": "color", "$value": "#646a75" },
        "600": { "$type": "color", "$value": "#555b66" },
        "900": { "$type": "color", "$value": "#16181d" }
      },
      "night": {
        "950": { "$type": "color", "$value": "#0f1115", "$description": "Dark page background (robot metal at night)" },
        "900": { "$type": "color", "$value": "#171a20" },
        "850": { "$type": "color", "$value": "#1f232b" },
        "700": { "$type": "color", "$value": "#2e333d" },
        "500": { "$type": "color", "$value": "#686e7b" },
        "300": { "$type": "color", "$value": "#7c8290" },
        "200": { "$type": "color", "$value": "#a6abb6" },
        "50": { "$type": "color", "$value": "#eceef2" }
      },
      "calco": {
        "$description": "Brand accent: the ultramarine of carbon-copy paper. Never used to fill a status.",
        "100": { "$type": "color", "$value": "#e3e4ff" },
        "300": { "$type": "color", "$value": "#a9adff" },
        "400": { "$type": "color", "$value": "#8a8fff" },
        "500": { "$type": "color", "$value": "#4f53e6" },
        "600": { "$type": "color", "$value": "#3d3fd8" },
        "700": { "$type": "color", "$value": "#2e2fb0" },
        "900": { "$type": "color", "$value": "#1b1c5c" }
      },
      "green": {
        "100": { "$type": "color", "$value": "#e2f3e8" },
        "400": { "$type": "color", "$value": "#5fd392" },
        "700": { "$type": "color", "$value": "#1d7a46" },
        "900": { "$type": "color", "$value": "#12301f" }
      },
      "orange": {
        "100": { "$type": "color", "$value": "#fdf0dc" },
        "400": { "$type": "color", "$value": "#f5b456" },
        "700": { "$type": "color", "$value": "#a0520a" },
        "900": { "$type": "color", "$value": "#3a2709" }
      },
      "red": {
        "100": { "$type": "color", "$value": "#fbe4e4" },
        "400": { "$type": "color", "$value": "#ff8a86" },
        "700": { "$type": "color", "$value": "#c0262d" },
        "900": { "$type": "color", "$value": "#3d1517" }
      },
      "teal": {
        "100": { "$type": "color", "$value": "#ddf1f3" },
        "400": { "$type": "color", "$value": "#5cc9d6" },
        "700": { "$type": "color", "$value": "#11707e" },
        "900": { "$type": "color", "$value": "#0f2c31" }
      },
      "bonobot": {
        "$description": "Mascot placeholder colors. The illustrator delivers SVGs with fills named after these tokens.",
        "fur": { "$type": "color", "$value": "#2b211d" },
        "fur-light": { "$type": "color", "$value": "#4a3a33" },
        "face": { "$type": "color", "$value": "#e9b8a2" },
        "lip": { "$type": "color", "$value": "#d98880" },
        "metal": { "$type": "color", "$value": "#a3abb6" },
        "metal-dark": { "$type": "color", "$value": "#6b7380" }
      }
    },
    "font": {
      "display": { "$type": "fontFamily", "$value": ["Bricolage Grotesque", "Avenir Next", "system-ui", "sans-serif"], "$description": "Headlines, big numbers, wordmark. OFL." },
      "sans": { "$type": "fontFamily", "$value": ["Atkinson Hyperlegible Next", "system-ui", "-apple-system", "Segoe UI", "sans-serif"], "$description": "UI and running text. Built for legibility: 0/O and 1/l/I are distinct. OFL." },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "SF Mono", "Menlo", "monospace"], "$description": "Amounts, invoice numbers, IDs, commands. OFL." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 },
      "black": { "$type": "fontWeight", "$value": 800 }
    },
    "fs": {
      "$description": "Type scale. 2xs-lg serve both surfaces (extension base = sm = 14px). xl-display are fluid for the web (320-1440px) and fixed caps for the extension.",
      "2xs": { "$type": "dimension", "$value": "11px" },
      "xs": { "$type": "dimension", "$value": "12px" },
      "sm": { "$type": "dimension", "$value": "14px" },
      "md": { "$type": "dimension", "$value": "16px" },
      "lg": { "$type": "dimension", "$value": "18px" },
      "xl": { "$type": "dimension", "$value": "clamp(20px, 1.1rem + 0.6vw, 24px)" },
      "2xl": { "$type": "dimension", "$value": "clamp(24px, 1.2rem + 1.4vw, 36px)" },
      "3xl": { "$type": "dimension", "$value": "clamp(32px, 1.4rem + 3vw, 56px)" },
      "display": { "$type": "dimension", "$value": "clamp(40px, 1.6rem + 5.2vw, 84px)" }
    },
    "lh": {
      "tight": { "$type": "number", "$value": 1.05 },
      "snug": { "$type": "number", "$value": 1.25 },
      "body": { "$type": "number", "$value": 1.5 }
    },
    "space": {
      "$description": "4px base grid shared by web and extension.",
      "0": { "$type": "dimension", "$value": "0px" },
      "1": { "$type": "dimension", "$value": "4px" },
      "2": { "$type": "dimension", "$value": "8px" },
      "3": { "$type": "dimension", "$value": "12px" },
      "4": { "$type": "dimension", "$value": "16px" },
      "5": { "$type": "dimension", "$value": "20px" },
      "6": { "$type": "dimension", "$value": "24px" },
      "8": { "$type": "dimension", "$value": "32px" },
      "10": { "$type": "dimension", "$value": "40px" },
      "12": { "$type": "dimension", "$value": "48px" },
      "16": { "$type": "dimension", "$value": "64px" },
      "24": { "$type": "dimension", "$value": "96px" }
    },
    "radius": {
      "xs": { "$type": "dimension", "$value": "4px" },
      "sm": { "$type": "dimension", "$value": "6px" },
      "md": { "$type": "dimension", "$value": "10px" },
      "lg": { "$type": "dimension", "$value": "16px" },
      "pill": { "$type": "dimension", "$value": "999px" }
    },
    "size": {
      "target": { "$type": "dimension", "$value": "32px", "$description": "Minimum hit target in the extension." },
      "icon-sm": { "$type": "dimension", "$value": "16px" },
      "icon-md": { "$type": "dimension", "$value": "20px" },
      "icon-lg": { "$type": "dimension", "$value": "24px" },
      "popup": { "$type": "dimension", "$value": "420px" },
      "content": { "$type": "dimension", "$value": "1160px" },
      "measure": { "$type": "dimension", "$value": "68ch" }
    },
    "duration": {
      "instant": { "$type": "duration", "$value": "80ms" },
      "fast": { "$type": "duration", "$value": "140ms" },
      "base": { "$type": "duration", "$value": "220ms" },
      "slow": { "$type": "duration", "$value": "360ms" },
      "stamp": { "$type": "duration", "$value": "520ms", "$description": "Signature: Bonobot's stamp landing on the finished batch." }
    },
    "ease": {
      "out": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] },
      "in-out": { "$type": "cubicBezier", "$value": [0.65, 0, 0.35, 1] },
      "stamp": { "$type": "cubicBezier", "$value": [0.3, 1.6, 0.5, 1], "$description": "Overshoot for the stamp and copy-slide." }
    }
  },
  "semantic": {
    "light": {
      "bg": { "$type": "color", "$value": "{primitive.color.steel.50}" },
      "surface": { "$type": "color", "$value": "{primitive.color.white}" },
      "surface-2": { "$type": "color", "$value": "{primitive.color.steel.100}" },
      "border": { "$type": "color", "$value": "{primitive.color.steel.200}", "$description": "Decorative dividers only." },
      "border-strong": { "$type": "color", "$value": "{primitive.color.steel.400}", "$description": "Input and control borders (3:1 non-text contrast)." },
      "text": { "$type": "color", "$value": "{primitive.color.steel.900}" },
      "text-2": { "$type": "color", "$value": "{primitive.color.steel.600}" },
      "text-3": { "$type": "color", "$value": "{primitive.color.steel.500}" },
      "accent": { "$type": "color", "$value": "{primitive.color.calco.600}", "$description": "Brand: primary action, links, focus ring, selection." },
      "accent-hover": { "$type": "color", "$value": "{primitive.color.calco.700}" },
      "accent-text": { "$type": "color", "$value": "{primitive.color.calco.600}" },
      "accent-soft": { "$type": "color", "$value": "{primitive.color.calco.100}" },
      "on-accent": { "$type": "color", "$value": "{primitive.color.white}" },
      "copy": { "$type": "color", "$value": "{primitive.color.steel.900}", "$description": "Color of the signature carbon-copy offset shadow." },
      "focus": { "$type": "color", "$value": "{primitive.color.calco.600}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.700}" },
      "success-soft": { "$type": "color", "$value": "{primitive.color.green.100}" },
      "warning": { "$type": "color", "$value": "{primitive.color.orange.700}" },
      "warning-soft": { "$type": "color", "$value": "{primitive.color.orange.100}" },
      "danger": { "$type": "color", "$value": "{primitive.color.red.700}" },
      "danger-soft": { "$type": "color", "$value": "{primitive.color.red.100}" },
      "on-danger": { "$type": "color", "$value": "{primitive.color.white}" },
      "info": { "$type": "color", "$value": "{primitive.color.teal.700}" },
      "info-soft": { "$type": "color", "$value": "{primitive.color.teal.100}" },
      "logo-plate": { "$type": "color", "$value": "{primitive.color.white}", "$description": "Neutral capsule behind third-party provider logos." }
    },
    "dark": {
      "bg": { "$type": "color", "$value": "{primitive.color.night.950}" },
      "surface": { "$type": "color", "$value": "{primitive.color.night.900}" },
      "surface-2": { "$type": "color", "$value": "{primitive.color.night.850}" },
      "border": { "$type": "color", "$value": "{primitive.color.night.700}" },
      "border-strong": { "$type": "color", "$value": "{primitive.color.night.500}" },
      "text": { "$type": "color", "$value": "{primitive.color.night.50}" },
      "text-2": { "$type": "color", "$value": "{primitive.color.night.200}" },
      "text-3": { "$type": "color", "$value": "{primitive.color.night.300}" },
      "accent": { "$type": "color", "$value": "{primitive.color.calco.500}" },
      "accent-hover": { "$type": "color", "$value": "{primitive.color.calco.600}" },
      "accent-text": { "$type": "color", "$value": "{primitive.color.calco.400}" },
      "accent-soft": { "$type": "color", "$value": "{primitive.color.calco.900}" },
      "on-accent": { "$type": "color", "$value": "{primitive.color.white}" },
      "copy": { "$type": "color", "$value": "{primitive.color.calco.300}" },
      "focus": { "$type": "color", "$value": "{primitive.color.calco.400}" },
      "success": { "$type": "color", "$value": "{primitive.color.green.400}" },
      "success-soft": { "$type": "color", "$value": "{primitive.color.green.900}" },
      "warning": { "$type": "color", "$value": "{primitive.color.orange.400}" },
      "warning-soft": { "$type": "color", "$value": "{primitive.color.orange.900}" },
      "danger": { "$type": "color", "$value": "{primitive.color.red.400}" },
      "danger-soft": { "$type": "color", "$value": "{primitive.color.red.900}" },
      "on-danger": { "$type": "color", "$value": "{primitive.color.night.950}" },
      "info": { "$type": "color", "$value": "{primitive.color.teal.400}" },
      "info-soft": { "$type": "color", "$value": "{primitive.color.teal.900}" },
      "logo-plate": { "$type": "color", "$value": "{primitive.color.night.50}" }
    },
    "shadow": {
      "copy": { "$type": "shadow", "$value": { "offsetX": "3px", "offsetY": "3px", "blur": "0px", "spread": "0px", "color": "{semantic.copy}" }, "$description": "Signature: the carbon copy behind the primary action." },
      "copy-hover": { "$type": "shadow", "$value": { "offsetX": "5px", "offsetY": "5px", "blur": "0px", "spread": "0px", "color": "{semantic.copy}" } },
      "copy-pressed": { "$type": "shadow", "$value": { "offsetX": "1px", "offsetY": "1px", "blur": "0px", "spread": "0px", "color": "{semantic.copy}" } },
      "raised": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "-12px", "color": "#00000040" } }
    }
  },
  "contrastPairs": {
    "$description": "Text/background combinations that must pass WCAG AA (4.5:1; 3:1 for border-strong). Checked in both modes by scripts/check-contrast.mjs.",
    "$value": [
      ["text", "bg"], ["text", "surface"], ["text", "surface-2"],
      ["text-2", "bg"], ["text-2", "surface"], ["text-2", "surface-2"],
      ["text-3", "bg"], ["text-3", "surface"],
      ["accent-text", "bg"], ["accent-text", "surface"],
      ["on-accent", "accent"], ["on-accent", "accent-hover"],
      ["accent-text", "accent-soft"],
      ["success", "bg"], ["success", "surface"], ["success", "success-soft"],
      ["warning", "bg"], ["warning", "surface"], ["warning", "warning-soft"],
      ["danger", "bg"], ["danger", "surface"], ["danger", "danger-soft"],
      ["on-danger", "danger"],
      ["info", "bg"], ["info", "surface"], ["info", "info-soft"],
      ["border-strong", "bg", 3], ["border-strong", "surface", 3], ["focus", "bg", 3], ["focus", "surface", 3]
    ]
  }
}
